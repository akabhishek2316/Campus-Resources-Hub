# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. NEVER expose this in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# College time zone offset from UTC in minutes (India = 330, UTC = 0)
NEXT_PUBLIC_TZ_OFFSET_MIN=330
NEXT_PUBLIC_TZ_LABEL=IST

# Optional: only allow sign-ups from this email domain (leave empty to allow any)
ALLOWED_EMAIL_DOMAIN=

# Optional AI (app works without it). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: protects /api/cron. If set, call with header  x-cron-secret: <value>
CRON_SECRET=

# Branding shown in the header, footer, login and landing page
NEXT_PUBLIC_COLLEGE_NAME=Demo Institute of Technology
NEXT_PUBLIC_COLLEGE_SHORT=DIT

# Optional: public base URL used to create absolute manager invitation links.
NEXT_PUBLIC_SITE_URL=
